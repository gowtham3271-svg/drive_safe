# ==============================================================================
# INTELLIGENT ROAD SAFETY & BLIND-TURN HAZARD DETECTION SYSTEM
# Master Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# ------------------------------------------------------------------------------
# Base URL for the FastAPI backend API server (do not hard-code localhost)
VITE_API_BASE_URL=http://localhost:8000

# Demo Mode toggle:
#   true  = Uses high-fidelity controlled sample road scenarios for evaluation
#   false = Queries live FastAPI backend and real Raspberry Pi 4 edge stream
VITE_DEMO_MODE=true

# Mapbox / Google Maps API Key (Optional):
# Leaflet runs with OpenStreetMap / CartoDB tiles out of the box with zero keys.
# Set this key if you wish to use custom Mapbox dark vector tiles.
VITE_MAP_API_KEY=

# Supabase Public Anonymous Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key


# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ------------------------------------------------------------------------------
# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase API Key (Anon key or Service Role key for backend operations)
# NEVER commit private service role keys to git or expose them in the frontend!
SUPABASE_KEY=your-supabase-anon-or-service-key

# Fallback mode toggle
DEMO_MODE=false
